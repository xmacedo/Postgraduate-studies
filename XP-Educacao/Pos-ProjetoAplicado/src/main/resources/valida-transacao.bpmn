    <bpmn:endEvent id="Event_00xrecv" name="Encerra Transação">
      <bpmn:incoming>Flow_0vs8y6y</bpmn:incoming>
      <bpmn:incoming>Flow_1vvmj63</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="Activity_0mdduw4" name="Entra em contato com dono do Cartão">
      <bpmn:extensionElements>
        <camunda:formData>
          <camunda:formField id="transacaoValida" label="Transação é valida?" type="boolean" defaultValue="">
            <camunda:properties />
          </camunda:formField>
          <camunda:formField id="valorTransacao" label="valorTransacao" type="string" />
          <camunda:formField id="paisOrigem" label="Pais Origem" type="string" />
        </camunda:formData>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1bhk0zh</bpmn:incoming>
      <bpmn:outgoing>Flow_0vs8y6y</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:scriptTask id="Activity_1ovnrz9" name="Nega Transação" scriptFormat="JavaScript">
      <bpmn:incoming>Flow_1pyrtcg</bpmn:incoming>
      <bpmn:outgoing>Flow_1vvmj63</bpmn:outgoing>
      <bpmn:script>print("Hello");</bpmn:script>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_1th8eqc" name="Transação é Válida?">
      <bpmn:incoming>Flow_18z81ai</bpmn:incoming>
      <bpmn:outgoing>Flow_1bhk0zh</bpmn:outgoing>
      <bpmn:outgoing>Flow_1pyrtcg</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0vs8y6y" sourceRef="Activity_0mdduw4" targetRef="Event_00xrecv" />
    <bpmn:sequenceFlow id="Flow_1vvmj63" sourceRef="Activity_1ovnrz9" targetRef="Event_00xrecv" />
    <bpmn:sequenceFlow id="Flow_1bhk0zh" name="Não" sourceRef="Gateway_1th8eqc" targetRef="Activity_0mdduw4">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transacaoValida==false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_1pyrtcg" name="Sim!" sourceRef="Gateway_1th8eqc" targetRef="Activity_1ovnrz9">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transacaoValida==true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>
