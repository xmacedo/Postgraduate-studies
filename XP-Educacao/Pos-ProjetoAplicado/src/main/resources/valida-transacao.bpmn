  <bpmn:collaboration id="Collaboration_04ysmt1">
    <bpmn:participant id="Participant_1g6dxhz" name="Valida Transacao" processRef="valida-transacao" />
  </bpmn:collaboration>
  <bpmn:process id="valida-transacao" isExecutable="true">
    <bpmn:businessRuleTask id="Activity_0w3vj0i" name="Avalia Transcao no DMN" camunda:resultVariable="transacaoValida" camunda:decisionRef="transacao-decision" camunda:mapDecisionResult="singleEntry" camunda:decisionRefTenantId="">
      <bpmn:extensionElements>
        <camunda:inputOutput>
          <camunda:inputParameter name="valorTransacao">${valorTransacao}</camunda:inputParameter>
          <camunda:inputParameter name="paisOrigem">${paisOrigem}</camunda:inputParameter>
        </camunda:inputOutput>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0jrplq5</bpmn:incoming>
      <bpmn:outgoing>Flow_18z81ai</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:startEvent id="StartEvent_1">
      <bpmn:outgoing>Flow_0jrplq5</bpmn:outgoing>
